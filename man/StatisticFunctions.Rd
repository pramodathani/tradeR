\subsection{\code{StatisticFunctions$beta()}}{
  Adds the rolling beta of the instrument against a benchmark, such as an index.

TA-Lib's beta works on the change from each candle to the next, so a beta of 1 means the instrument moved in step with the benchmark. Candles are matched by time, and a candle either side lacks is left out.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{StatisticFunctions$beta(
  benchmark,
  window = 14,
  column = "close",
  interval = "day",
  from_date = NULL,
  to_date = NULL,
  days = NULL,
  adjusted = TRUE
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{benchmark}}{The instrument to measure against, such as a \code{NonTradeableInstrument} for NIFTY, or any other object with a \code{prices()} method.}
      \item{\code{window}}{The integer number of candles in each calculation window.}
      \item{\code{column}}{The character name of the candle column to use from both, such as \code{close}.}
      \item{\code{interval}}{The character candle interval, such as \code{day} or \verb{5minute}.}
      \item{\code{from_date}}{The first day of the range as a \code{Date} or a \code{YYYY-MM-DD} character, or \code{NULL} when days is given.}
      \item{\code{to_date}}{The last day of the range as a \code{Date} or a \code{YYYY-MM-DD} character, or \code{NULL} when days is given.}
      \item{\code{days}}{The integer number of days to count back from today, or \code{NULL} when from_date and to_date are given.}
      \item{\code{adjusted}}{A logical that is \code{TRUE} for prices adjusted for splits and bonuses.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Details}{
    Errors: signals \code{UnifiedBrokerInterfaceError} when UBI refused the request or could not be reached, and a plain error when TA-Lib rejects \code{window}.
  }
  \subsection{Returns}{
    A \code{data.frame} of the matched candles with a \verb{benchmark_<column>} column and a \verb{beta_<window>} column added, or \code{NULL} when UBI has no candles for either instrument in the range.
  }
  \subsection{Examples}{
    \if{html}{\out{<div class="r example copy">}}
    \preformatted{infosys <- Equity$new(exchange = "nse", symbol = "INFY")
nifty <- EquityIndex$new(exchange = "nse", symbol = "NIFTY")
frame <- infosys$beta(benchmark = nifty, window = 20, days = 180)
print(tail(frame[, c("datetime", "beta_20")], 5))

nifty <- EquityIndex$new(exchange = "nse", symbol = "NIFTY")
symbols <- c(
  "INFY",
  "TCS",
  "HDFCBANK",
  "RELIANCE"
)
for (symbol in symbols) {
  share <- Equity$new(exchange = "nse", symbol = symbol)
  frame <- share$beta(benchmark = nifty, window = 60, days = 365)
  latest_beta <- frame$beta_60[[nrow(frame)]]
  print(sprintf("\%s: beta \%.2f", symbol, latest_beta))
}
}
    \if{html}{\out{</div>}}
  }
}

