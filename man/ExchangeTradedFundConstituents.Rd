\if{latex}{\out{\hypertarget{method-ExchangeTradedFundConstituents-document}{}}}
\subsection{\code{ExchangeTradedFundConstituents$document()}}{
  Describes the fund's holdings as a named list for storing in MongoDB.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{ExchangeTradedFundConstituents$document(effective_date = NULL)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{effective_date}}{The first day the holdings are in effect as a \code{Date} or a \code{"YYYY-MM-DD"} character value, or \code{NULL} for today.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Returns}{
    The named list \code{AssetBasket$document()} gives, with \code{indicative_net_asset_value_instrument_id} added, which is \code{NULL} when no indicative value is linked.
  }
  \subsection{Examples}{
    \if{html}{\out{<div class="r example copy">}}
    \preformatted{weights <- c(
  HDFCBANK = 13,
  ICICIBANK = 9,
  RELIANCE = 8.5,
  INFY = 5,
  BHARTIARTL = 4.5
)
members <- list()
for (symbol in names(weights)) {
  share <- Equity$new(exchange = "nse", symbol = symbol)
  members[[length(members) + 1]] <- BasketMember$new(
    share,
    weight = weights[[symbol]]
  )
}
fund <- ExchangeTradedFund$new(exchange = "nse", symbol = "NIFTYBEES")
holdings <- ExchangeTradedFundConstituents$new(
  name = "NIFTYBEES",
  members = members,
  fund = fund
)
document <- holdings$document(effective_date = "2026-09-01")
cat(document$kind, document$linked_instrument_id, "\n")
print(document$indicative_net_asset_value_instrument_id)

for (member_document in holdings$document()$members) {
  cat(member_document$symbol, member_document$weight, "\n")
}
}
    \if{html}{\out{</div>}}
  }
}

