\if{html}{\out{<a id="method-ExchangeTradedFundConstituents-initialize"></a>}}
\if{latex}{\out{\hypertarget{method-ExchangeTradedFundConstituents-initialize}{}}}
\subsection{\code{ExchangeTradedFundConstituents$new()}}{
  Initialises the fund's holdings.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{ExchangeTradedFundConstituents$new(
  name,
  members,
  fund = NULL,
  indicative_net_asset_value = NULL,
  unmapped_weight = 0,
  unified_broker_interface = NULL
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{name}}{The character name of the basket, usually the fund's symbol, such as \code{"NIFTYBEES"}.}
      \item{\code{members}}{A list of \code{BasketMember} objects, one per holding, each a different instrument, with a weight on every member or on none.}
      \item{\code{fund}}{The \code{Instrument} of the fund itself, or \code{NULL}.}
      \item{\code{indicative_net_asset_value}}{The \code{Instrument} carrying the fund's indicative net asset value, or \code{NULL}.}
      \item{\code{unmapped_weight}}{The numeric share of the fund, between 0 and 1, held in things UBI cannot price, such as cash.}
      \item{\code{unified_broker_interface}}{The \code{UnifiedBrokerInterface} to send requests through, or \code{NULL} to share the one every instrument uses.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Details}{
    Errors: signals \code{BasketMemberError} when \code{members} is empty, names an instrument twice, or gives weights to only some members; and \code{ValueError} when \code{unmapped_weight} is not between 0 and 1.
  }
  \subsection{Returns}{
    A new \code{ExchangeTradedFundConstituents} object.
  }
}

\if{html}{\out{<hr>}}
\if{html}{\out{<a id="method-ExchangeTradedFundConstituents-tracking_difference"></a>}}
\if{latex}{\out{\hypertarget{method-ExchangeTradedFundConstituents-tracking_difference}{}}}
\subsection{\code{ExchangeTradedFundConstituents$tracking_difference()}}{
  Calculates the fund's return minus its holdings' return over a range.

A small negative number is normal, since the fund pays fees its holdings do not. The holdings' return is the return of today's weights held through the range, so it drifts from the fund's real history when the holdings changed during it.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{ExchangeTradedFundConstituents$tracking_difference(
  interval = "day",
  from_date = NULL,
  to_date = NULL,
  days = NULL,
  adjusted = TRUE
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{interval}}{The character candle interval, such as \code{"day"} or \code{"5minute"}.}
      \item{\code{from_date}}{The first day of the range as a \code{Date} or a \code{"YYYY-MM-DD"} character value, or \code{NULL} when \code{days} is given.}
      \item{\code{to_date}}{The last day of the range as a \code{Date} or a \code{"YYYY-MM-DD"} character value, or \code{NULL} when \code{days} is given.}
      \item{\code{days}}{The integer number of days to count back from today, or \code{NULL} when \code{from_date} and \code{to_date} are given.}
      \item{\code{adjusted}}{A logical that is \code{TRUE} for prices adjusted for splits and bonuses.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Details}{
    Errors: signals \code{BasketMemberError} when UBI answered an error for one or more members; and a \code{UnifiedBrokerInterfaceError} subclass when UBI refused a request or could not be reached.
  }
  \subsection{Returns}{
    The numeric difference of the two cumulative returns, such as -0.001 for a tenth of a percent behind, or \code{NULL} when no fund is linked or either has too few candles.
  }
  \subsection{Examples}{
    \if{html}{\out{<div class="r example copy">}}
    \preformatted{weights <- c(
  HDFCBANK = 13,
  ICICIBANK = 9,
  RELIANCE = 8.5,
  INFY = 5,
  BHARTIARTL = 4.5
)
members <- list()
for (symbol in names(weights)) {
  share <- Equity$new(exchange = "nse", symbol = symbol)
  members[[length(members) + 1]] <- BasketMember$new(
    share,
    weight = weights[[symbol]]
  )
}
fund <- ExchangeTradedFund$new(exchange = "nse", symbol = "NIFTYBEES")
holdings <- ExchangeTradedFundConstituents$new(
  name = "NIFTYBEES",
  members = members,
  fund = fund
)
difference <- holdings$tracking_difference(days = 365)
cat(sprintf("Tracking difference: \%+.4f\n", difference))

for (days in c(
  90,
  365
)) {
  print(c(
    days,
    holdings$tracking_difference(days = days)
  ))
}
}
    \if{html}{\out{</div>}}
  }
}

