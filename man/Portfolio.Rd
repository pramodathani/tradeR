\subsection{\code{Portfolio$new()}}{
  Initialises the portfolio and checks that every member has a quantity.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{Portfolio$new(name, members, unified_broker_interface = NULL)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{name}}{The character name of the portfolio.}
      \item{\code{members}}{A list of \code{BasketMember} objects, each with a quantity, negative for a short position, and each a different instrument.}
      \item{\code{unified_broker_interface}}{The \code{UnifiedBrokerInterface} to send requests through, or \code{NULL} to share the one every instrument uses.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Details}{
    Errors: signals \code{BasketMemberError} when \code{members} is empty, names an instrument twice, or has a member without a quantity.
