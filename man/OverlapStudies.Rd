\subsection{\code{OverlapStudies$simple_moving_average()}}{
  Adds the simple moving average of one candle column.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{OverlapStudies$simple_moving_average(
  window = 10,
  column = "close",
  interval = "day",
  from_date = NULL,
  to_date = NULL,
  days = NULL,
  adjusted = TRUE
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{window}}{The integer number of candles in each calculation window.}
      \item{\code{column}}{The character name of the candle column to use, such as \code{"close"}.}
