\if{html}{\out{<a id="method-CandlestickPatterns-candle_two_crows"></a>}}
\if{latex}{\out{\hypertarget{method-CandlestickPatterns-candle_two_crows}{}}}
\subsection{\code{CandlestickPatterns$candle_two_crows()}}{
  Marks where the two crows candlestick pattern appears.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{CandlestickPatterns$candle_two_crows(
  interval = "day",
  from_date = NULL,
  to_date = NULL,
  days = NULL,
  adjusted = TRUE
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{interval}}{The character candle interval, such as \code{day} or \verb{5minute}.}
      \item{\code{from_date}}{The first day of the range as a \code{Date} or a \code{YYYY-MM-DD} character, or \code{NULL} when days is given.}
      \item{\code{to_date}}{The last day of the range as a \code{Date} or a \code{YYYY-MM-DD} character, or \code{NULL} when days is given.}
      \item{\code{days}}{The integer number of days to count back from today, or \code{NULL} when from_date and to_date are given.}
      \item{\code{adjusted}}{A logical that is \code{TRUE} for prices adjusted for splits and bonuses.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Details}{
    Errors: signals \code{UnifiedBrokerInterfaceError} when UBI refused the request or could not be reached.
  }
  \subsection{Returns}{
    A \code{data.frame} of the candles with a \code{candle_two_crows} column added, which is 100 for a bullish match, -100 for a bearish match and 0 otherwise, or \code{NULL} when UBI has no candles for the range.
  }
  \subsection{Examples}{
    \if{html}{\out{<div class="r example copy">}}
    \preformatted{infosys <- Equity$new(exchange = "nse", symbol = "INFY")
pattern_frame <- infosys$candle_two_crows(days = 365)
pattern_column <- "candle_two_crows"
matches <- pattern_frame[pattern_frame[[pattern_column]] != 0, ]
if (nrow(matches) == 0) {
  print("No match in the last year.")
}
for (position in seq_len(nrow(matches))) {
  row <- matches[position, ]
  print(paste(format(row$datetime, "\%Y-\%m-\%d"), row[[pattern_column]]))
}

symbols <- c(
  "INFY",
  "TCS",
  "HDFCBANK"
)
pattern_column <- "candle_two_crows"
for (symbol in symbols) {
  share <- Equity$new(exchange = "nse", symbol = symbol)
  pattern_frame <- share$candle_two_crows(days = 1825)
  match_count <- sum(pattern_frame[[pattern_column]] != 0)
  print(sprintf("\%s: \%d matches in five years", symbol, match_count))
}
}
    \if{html}{\out{</div>}}
  }
}

