\if{html}{\out{<a id="method-Instrument-prices"></a>}}
\if{latex}{\out{\hypertarget{method-Instrument-prices}{}}}
\subsection{\code{Instrument$prices()}}{
  Fetches the instrument's candles for a range from UBI.

Give either \code{from_date} and \code{to_date}, or \code{days}. UBI serves any range in one request.

The examples below, in order:
\itemize{
\item Print the last five daily candles of Infosys.
\item Work out the Nifty index's return over a fixed range of dates from its first and last close.
\item Compare adjusted and unadjusted closes of Reliance over five years, where a split or bonus shows up as a price factor below 1.
}
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{Instrument$prices(
  interval = "day",
  from_date = NULL,
  to_date = NULL,
  days = NULL,
  adjusted = TRUE
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{interval}}{The character candle interval, such as \code{"day"} or \code{"5minute"}.}
      \item{\code{from_date}}{The first day of the range as a \code{Date} or a \code{"YYYY-MM-DD"} character value, or \code{NULL} when \code{days} is given.}
      \item{\code{to_date}}{The last day of the range as a \code{Date} or a \code{"YYYY-MM-DD"} character value, or \code{NULL} when \code{days} is given.}
      \item{\code{days}}{The integer number of days to count back from today, or \code{NULL} when \code{from_date} and \code{to_date} are given.}
      \item{\code{adjusted}}{A logical that is \code{TRUE} for prices adjusted for splits and bonuses.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Details}{
    Errors: signals \code{BadRequestError} when the range or interval is invalid, such as both \code{days} and \code{from_date} given; and another \code{UnifiedBrokerInterfaceError} subclass for any other failure reported by, or on the way to, UBI.
  }
  \subsection{Returns}{
    A \code{data.frame} sorted by time, with \code{exchange}, \code{segment}, \code{interval}, \code{datetime} in India time, \code{open}, \code{high}, \code{low}, \code{close}, \code{volume} and \code{oi} columns, plus \code{price_factor} when the prices are adjusted, or \code{NULL} when UBI has no candles for the range.
  }
  \subsection{Examples}{
    \if{html}{\out{<div class="r example copy">}}
    \preformatted{infosys <- TradeableInstrument$new(
  exchange = "nse",
  segment = "equities",
  symbol = "INFY"
)
candles <- infosys$prices(interval = "day", days = 10)
columns <- c(
  "datetime",
  "open",
  "high",
  "low",
  "close",
  "volume"
)
print(tail(candles[, columns], 5))

nifty <- NonTradeableInstrument$new(
  exchange = "nse",
  segment = "equity_indices",
  symbol = "NIFTY"
)
candles <- nifty$prices(
  interval = "day",
  from_date = "2026-01-01",
  to_date = "2026-06-30"
)
first_close <- candles$close[[1]]
last_close <- candles$close[[nrow(candles)]]
change_percent <- (last_close - first_close) / first_close * 100
cat(
  sprintf(
    "Nifty from \%s to \%s: \%.2f\%\%",
    first_close,
    last_close,
    change_percent
  ),
  "\n"
)

reliance <- TradeableInstrument$new(
  exchange = "nse",
  segment = "equities",
  symbol = "RELIANCE"
)
adjusted <- reliance$prices(days = 1825, adjusted = TRUE)
unadjusted <- reliance$prices(days = 1825, adjusted = FALSE)
cat("First adjusted close:", adjusted$close[[1]], "\n")
cat("First unadjusted close:", unadjusted$close[[1]], "\n")
cat("Smallest price factor:", min(adjusted$price_factor), "\n")
}
    \if{html}{\out{</div>}}
  }
}

\if{html}{\out{<hr>}}
\if{html}{\out{<a id="method-Instrument-ticks"></a>}}
\if{latex}{\out{\hypertarget{method-Instrument-ticks}{}}}
\subsection{\code{Instrument$ticks()}}{
  Fetches every tick UBI's unified live feed recorded for the instrument in a period.

The period includes \code{start} and leaves out \code{end}. A value without an offset is read as India time, and a bare date means midnight at the start of that day. A busy instrument records many ticks a second, so ask for short periods.

The examples below, in order:
\itemize{
\item Print the best bid and offer of Vodafone Idea for the first minute of a session.
\item Work out the share of ticks in an hour at which the spread was a single tick.
}
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{Instrument$ticks(start, end, adjusted = TRUE)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{start}}{The first instant to include, as a \code{POSIXct} or a character value such as \code{"2026-09-29 10:00"}.}
      \item{\code{end}}{The first instant to leave out, as a \code{POSIXct} or a character value such as \code{"2026-09-29 15:30"}.}
      \item{\code{adjusted}}{A logical that is \code{TRUE} for prices adjusted for splits and bonuses.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Details}{
    Errors: signals \code{BadRequestError} when the period is invalid, such as an end that is not after the start; and another \code{UnifiedBrokerInterfaceError} subclass for any other failure reported by, or on the way to, UBI.
  }
  \subsection{Returns}{
    A \code{data.frame} sorted by time, with \code{exchange}, \code{segment}, \code{datetime} (when the tick was received), \code{exchange_time} and \code{last_trade_time}, all in India time, then \code{broker}, \code{last_price}, \code{last_quantity}, \code{average_price}, \code{volume}, \code{buy_quantity}, \code{sell_quantity}, \code{oi} and the order book flattened into \code{bid1_price} to \code{bid5_orders} and \code{offer1_price} to \code{offer5_orders}, or \code{NULL} when no tick was recorded in the period.
  }
  \subsection{Examples}{
    \if{html}{\out{<div class="r example copy">}}
    \preformatted{vodafone_idea <- TradeableInstrument$new(
  exchange = "nse",
  segment = "equities",
  symbol = "IDEA"
)
ticks <- vodafone_idea$ticks(
  start = "2026-09-29 09:15",
  end = "2026-09-29 09:16"
)
columns <- c(
  "datetime",
  "bid1_price",
  "offer1_price"
)
print(head(ticks[, columns], 10))

vodafone_idea <- TradeableInstrument$new(
  exchange = "nse",
  segment = "equities",
  symbol = "IDEA"
)
ticks <- vodafone_idea$ticks(
  start = "2026-09-29 10:00",
  end = "2026-09-29 11:00"
)
spread <- ticks$offer1_price - ticks$bid1_price
tick_size <- as.numeric(vodafone_idea$tick_size)
one_tick <- abs(spread - tick_size) < 1e-9
cat(
  sprintf(
    "\%s ticks, \%.1f\%\% at one tick",
    nrow(ticks),
    mean(one_tick) * 100
  ),
  "\n"
)
}
    \if{html}{\out{</div>}}
  }
}

