\subsection{\code{PriceTransforms$weighted_close()}}{
  Adds each candle's weighted close, which counts the close twice alongside the high and low.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{PriceTransforms$weighted_close(
  interval = "day",
  from_date = NULL,
  to_date = NULL,
  days = NULL,
  adjusted = TRUE
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{interval}}{The character candle interval, such as \code{day} or \verb{5minute}.}
      \item{\code{from_date}}{The first day of the range as a \code{Date} or a \code{YYYY-MM-DD} character, or \code{NULL} when days is given.}
      \item{\code{to_date}}{The last day of the range as a \code{Date} or a \code{YYYY-MM-DD} character, or \code{NULL} when days is given.}
      \item{\code{days}}{The integer number of days to count back from today, or \code{NULL} when from_date and to_date are given.}
      \item{\code{adjusted}}{A logical that is \code{TRUE} for prices adjusted for splits and bonuses.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Details}{
    Errors: signals \code{UnifiedBrokerInterfaceError} when UBI refused the request or could not be reached.
  }
  \subsection{Returns}{
    A \code{data.frame} of the candles with a \code{wght_close} column added, or \code{NULL} when UBI has no candles for the range.
  }
  \subsection{Examples}{
    \if{html}{\out{<div class="r example copy">}}
    \preformatted{infosys <- Equity$new(exchange = "nse", symbol = "INFY")
frame <- infosys$weighted_close(days = 30)
print(tail(frame[, c("datetime", "wght_close")], 5))

nifty <- EquityIndex$new(exchange = "nse", symbol = "NIFTY")
weighted_frame <- nifty$weighted_close(days = 30)
typical_frame <- nifty$typical_price(days = 30)
weighted_close <- weighted_frame$wght_close[[nrow(weighted_frame)]]
typical_price <- typical_frame$typ_price[[nrow(typical_frame)]]
cat(sprintf("Weighted close \%.2f\n", weighted_close))
cat(sprintf("Typical price \%.2f\n", typical_price))
}
    \if{html}{\out{</div>}}
  }
}

