\section{Active bindings}{
  \if{html}{\out{<div class="r6-active-bindings">}}
  \describe{
    \item{\code{is_call}}{A logical that is \code{TRUE} when the option is a call, the right to buy the underlying.}

    \item{\code{is_put}}{A logical that is \code{TRUE} when the option is a put, the right to sell the underlying.}

    \item{\code{intrinsic_value}}{The numeric worth of the option if exercised now, read from the underlying's last price, or \code{NULL} when that price is unknown. For a call it is how far the underlying is above the strike, and for a put how far it is below, and it is never less than zero.}

    \item{\code{time_value}}{The numeric part of the premium above the intrinsic value, which is what the time left until expiry is worth, read from two quotes, or \code{NULL} when either is unknown.}

    \item{\code{in_the_money}}{A logical that is \code{TRUE} when the option has intrinsic value, read from the underlying's last price, or \code{NULL} when that price is unknown.}

    \item{\code{moneyness_percent}}{How far the option is in or out of the money, as a numeric percentage of the underlying's last price, or \code{NULL} when that price is unknown or zero. Positive means in the money and negative means out of it, for a call and a put alike, so a call struck 2 per cent above the underlying reads about -2.}

    \item{\code{breakeven_price}}{The numeric underlying price at expiry at which a buyer of the option at its last price neither gains nor loses, or \code{NULL} when the last price is unknown.}

    \item{\code{premium_per_lot}}{The numeric cost of buying one lot of the option at its last price, which is the last price times the lot size, or \code{NULL} when either is unknown.}

    \item{\code{notional_value}}{The numeric value of the underlying one lot controls at the strike price, which is the strike times the lot size, or \code{NULL} when the lot size is unknown.}
  }
  \if{html}{\out{</div>}}
}
