\if{html}{\out{<a id="method-AssetBasket-initialize"></a>}}
\if{latex}{\out{\hypertarget{method-AssetBasket-initialize}{}}}
\subsection{\code{AssetBasket$new()}}{
  Initialises the basket and checks its members.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{AssetBasket$new(
  name,
  members,
  linked_instrument = NULL,
  unmapped_weight = 0,
  unified_broker_interface = NULL
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{name}}{The character name of the basket.}
      \item{\code{members}}{A list of \code{BasketMember} objects with at least one member, each a different instrument, and either every member or no member given a weight.}
      \item{\code{linked_instrument}}{The \code{Instrument} whose contents the basket describes, or \code{NULL}.}
      \item{\code{unmapped_weight}}{The numeric share of the whole, between 0 and 1, held outside the members.}
      \item{\code{unified_broker_interface}}{The \code{UnifiedBrokerInterface} to send requests through, or \code{NULL} to share the one every instrument uses.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Details}{
    Errors: signals \code{BasketMemberError} when \code{members} is empty, names an instrument twice, or gives weights to only some members; and \code{ValueError} when \code{unmapped_weight} is not between 0 and 1.
  }
  \subsection{Returns}{
    A new \code{AssetBasket} object.
  }
}

