\if{latex}{\out{\hypertarget{method-AssetBasket-member_prices}{}}}
\subsection{\code{AssetBasket$member_prices()}}{
  Fetches every member's candles for a range in one request.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{AssetBasket$member_prices(
  interval = "day",
  from_date = NULL,
  to_date = NULL,
  days = NULL,
  adjusted = TRUE
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{interval}}{The character candle interval, such as \code{"day"} or \code{"5minute"}.}
      \item{\code{from_date}}{The first day of the range as a \code{Date} or a \code{"YYYY-MM-DD"} character value, or \code{NULL} when \code{days} is given.}
      \item{\code{to_date}}{The last day of the range as a \code{Date} or a \code{"YYYY-MM-DD"} character value, or \code{NULL} when \code{days} is given.}
      \item{\code{days}}{The integer number of days to count back from today, or \code{NULL} when \code{from_date} and \code{to_date} are given.}
      \item{\code{adjusted}}{A logical that is \code{TRUE} for prices adjusted for splits and bonuses.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Details}{
    Errors: signals \code{BasketMemberError} when UBI answered an error for one or more members, all of which the message lists; \code{BadRequestError} when the range or interval is invalid; and another \code{UnifiedBrokerInterfaceError} subclass for any other failure reported by, or on the way to, UBI.
  }
  \subsection{Returns}{
    A \code{data.frame} with one row per member and candle, sorted by label and time, holding \code{label}, \code{instrument_id}, \code{exchange}, \code{segment}, \code{interval}, \code{datetime} in India time, \code{open}, \code{high}, \code{low}, \code{close}, \code{volume} and \code{oi}, plus any other column UBI sends such as \code{price_factor}, or \code{NULL} when no member has a candle in the range. A member with no candles has no rows.
  }
  \subsection{Examples}{
    \if{html}{\out{<div class="r example copy">}}
    \preformatted{weights <- c(
  INFY = 0.5,
  TCS = 0.3,
  HCLTECH = 0.2
)
members <- list()
for (symbol in names(weights)) {
  share <- Equity$new(exchange = "nse", symbol = symbol)
  members[[length(members) + 1]] <- BasketMember$new(
    share,
    weight = weights[[symbol]]
  )
}
basket <- AssetBasket$new(name = "IT shares", members = members)
frame <- basket$member_prices(days = 10)
print(tail(frame[, c("label", "datetime", "close")], 6))

bank_symbols <- c(
  "HDFCBANK",
  "ICICIBANK",
  "AXISBANK",
  "KOTAKBANK",
  "SBIN"
)
bank_members <- list()
for (symbol in bank_symbols) {
  share <- Equity$new(exchange = "nse", symbol = symbol)
  bank_members[[length(bank_members) + 1]] <- BasketMember$new(share)
}
banks <- AssetBasket$new(name = "banks", members = bank_members)
frame <- banks$member_prices(
  interval = "day",
  from_date = "2026-06-01",
  to_date = "2026-09-25"
)
print(table(frame$label))
}
    \if{html}{\out{</div>}}
  }
}

