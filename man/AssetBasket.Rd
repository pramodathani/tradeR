  }
  \subsection{Returns}{
    A named list with \code{name}, \code{kind}, \code{effective_date} as \code{"YYYY-MM-DD"} text, \code{linked_instrument_id}, \code{unmapped_weight}, \code{base_value} and a \code{members} list of named lists.
  }
  \subsection{Examples}{
