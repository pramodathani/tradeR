    \if{html}{\out{<div class="r">}}
    \preformatted{AssetBasket$risk_contributions(
  interval = "day",
  from_date = NULL,
  to_date = NULL,
  days = NULL,
  adjusted = TRUE
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{interval}}{The character candle interval, such as \code{"day"} or \code{"5minute"}.}
      \item{\code{from_date}}{The first day of the range as a \code{Date} or a \code{"YYYY-MM-DD"} character value, or \code{NULL} when \code{days} is given.}
      \item{\code{to_date}}{The last day of the range as a \code{Date} or a \code{"YYYY-MM-DD"} character value, or \code{NULL} when \code{days} is given.}
      \item{\code{days}}{The integer number of days to count back from today, or \code{NULL} when \code{from_date} and \code{to_date} are given.}
      \item{\code{adjusted}}{A logical that is \code{TRUE} for prices adjusted for splits and bonuses.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Details}{
    Errors: signals \code{BasketMemberError} when UBI answered an error for one or more members; and another \code{UnifiedBrokerInterfaceError} subclass for any other failure reported by, or on the way to, UBI.
  }
  \subsection{Returns}{
    A \code{data.frame} whose row names are the member labels, with numeric \code{weight} and \code{risk_contribution} columns, largest contribution first, or \code{NULL} when there are fewer than three shared candles or the basket never moved.
  }
  \subsection{Examples}{
    \if{html}{\out{<div class="r example copy">}}
    \preformatted{weights <- c(
  INFY = 0.5,
  TCS = 0.3,
  HCLTECH = 0.2
)
members <- list()
for (symbol in names(weights)) {
  share <- Equity$new(exchange = "nse", symbol = symbol)
  members[[length(members) + 1]] <- BasketMember$new(
    share,
    weight = weights[[symbol]]
  )
}
basket <- AssetBasket$new(name = "IT shares", members = members)
print(round(basket$risk_contributions(days = 180), 3))

bank_symbols <- c(
  "HDFCBANK",
  "ICICIBANK",
  "AXISBANK",
  "KOTAKBANK",
  "SBIN"
)
bank_members <- list()
for (symbol in bank_symbols) {
  share <- Equity$new(exchange = "nse", symbol = symbol)
  bank_members[[length(bank_members) + 1]] <- BasketMember$new(share)
}
banks <- AssetBasket$new(name = "banks", members = bank_members)
contributions <- banks$risk_contributions(days = 365)
for (label in rownames(contributions)) {
  row <- contributions[label, ]
  if (row$risk_contribution > row$weight * 1.1) {
    cat(sprintf("\%s carries more risk than its weight\n", label))
  }
}
print(round(contributions, 3))
}
    \if{html}{\out{</div>}}
  }
}

