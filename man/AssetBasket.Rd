\subsection{\code{AssetBasket$add_member()}}{
  Adds a member to the basket in memory, which \code{BasketStore$save()} then stores.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{AssetBasket$add_member(member)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{member}}{The \code{BasketMember} to add, weighted if and only if the other members are.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Details}{
    Errors: signals \code{BasketMemberError} when the instrument is already in the basket, or the member's weight does not match the others'.
  }
  \subsection{Returns}{
    \code{NULL}, invisibly.
  }
  \subsection{Examples}{
    \if{html}{\out{<div class="r example copy">}}
    \preformatted{weights <- c(
  INFY = 0.5,
  TCS = 0.3,
  HCLTECH = 0.2
)
members <- list()
for (symbol in names(weights)) {
  share <- Equity$new(exchange = "nse", symbol = symbol)
  members[[length(members) + 1]] <- BasketMember$new(
    share,
    weight = weights[[symbol]]
  )
}
basket <- AssetBasket$new(name = "IT shares", members = members)
wipro <- Equity$new(exchange = "nse", symbol = "WIPRO")
basket$add_member(BasketMember$new(wipro, weight = 0.1))
