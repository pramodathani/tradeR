\if{html}{\out{<a id="method-AssetBasket-prices"></a>}}
\if{latex}{\out{\hypertarget{method-AssetBasket-prices}{}}}
\subsection{\code{AssetBasket$prices()}}{
  Builds candles for the basket as a whole from its members' candles.

Each candle is the sum over members of a fixed quantity times the member's candle. A weighted basket takes its quantities from its weights at the first candle of the range, so the first close equals \code{base_value}; a \code{Portfolio} uses the quantities it holds. The open and close are exact; the high and low are an approximation, because the members do not all reach their highs and lows at the same moment. \code{volume} and \code{oi} are empty.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{AssetBasket$prices(
  interval = "day",
  from_date = NULL,
  to_date = NULL,
  days = NULL,
  adjusted = TRUE
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{interval}}{The character candle interval, such as \code{"day"} or \code{"5minute"}.}
      \item{\code{from_date}}{The first day of the range as a \code{Date} or a \code{"YYYY-MM-DD"} character value, or \code{NULL} when \code{days} is given.}
      \item{\code{to_date}}{The last day of the range as a \code{Date} or a \code{"YYYY-MM-DD"} character value, or \code{NULL} when \code{days} is given.}
      \item{\code{days}}{The integer number of days to count back from today, or \code{NULL} when \code{from_date} and \code{to_date} are given.}
      \item{\code{adjusted}}{A logical that is \code{TRUE} for prices adjusted for splits and bonuses.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Details}{
    Errors: signals \code{BasketMemberError} when UBI answered an error for one or more members; and another \code{UnifiedBrokerInterfaceError} subclass for any other failure reported by, or on the way to, UBI.
  }
  \subsection{Returns}{
    A \code{data.frame} sorted by time with \code{exchange} set to \code{NA}, \code{segment} set to the basket's \code{KIND}, \code{interval}, \code{datetime}, \code{open}, \code{high}, \code{low}, \code{close}, \code{volume} and \code{oi} columns, the last two all \code{NA}, or \code{NULL} when any member has no candles in the range or no candle is shared by all.
  }
  \subsection{Examples}{
    \if{html}{\out{<div class="r example copy">}}
    \preformatted{weights <- c(
  INFY = 0.5,
  TCS = 0.3,
  HCLTECH = 0.2
)
members <- list()
for (symbol in names(weights)) {
  share <- Equity$new(exchange = "nse", symbol = symbol)
  members[[length(members) + 1]] <- BasketMember$new(
    share,
    weight = weights[[symbol]]
  )
}
basket <- AssetBasket$new(name = "IT shares", members = members)
frame <- basket$prices(days = 30)
print(tail(frame[, c("datetime", "open", "high", "low", "close")]))

bank_symbols <- c(
  "HDFCBANK",
  "ICICIBANK",
  "AXISBANK",
  "KOTAKBANK",
  "SBIN"
)
bank_members <- list()
for (symbol in bank_symbols) {
  share <- Equity$new(exchange = "nse", symbol = symbol)
  bank_members[[length(bank_members) + 1]] <- BasketMember$new(share)
}
banks <- AssetBasket$new(name = "banks", members = bank_members)
frame <- banks$prices(from_date = "2026-06-01", to_date = "2026-09-25")
first_close <- frame$close[[1]]
last_close <- frame$close[[nrow(frame)]]
cat(sprintf("Return: \%.2f\%\%\n", (last_close / first_close - 1) * 100))

print(basket$sharpe_ratio(risk_free_rate = 0.065, days = 365))
}
    \if{html}{\out{</div>}}
  }
}

