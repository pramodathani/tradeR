\code{\link[tradeR:PriceAnalysis]{PriceAnalysis}} -> \code{\link[tradeR:PriceStatistics]{PriceStatistics}} -> \code{\link[tradeR:OverlapStudies]{OverlapStudies}} -> \code{\link[tradeR:MomentumIndicators]{MomentumIndicators}} -> \code{\link[tradeR:VolumeIndicators]{VolumeIndicators}} -> \code{\link[tradeR:CycleIndicators]{CycleIndicators}} -> \code{\link[tradeR:PriceTransforms]{PriceTransforms}} -> \code{\link[tradeR:VolatilityIndicators]{VolatilityIndicators}} -> \code{\link[tradeR:StatisticFunctions]{StatisticFunctions}} -> \code{\link[tradeR:MathTransforms]{MathTransforms}} -> \code{\link[tradeR:MathOperators]{MathOperators}} -> \code{\link[tradeR:CandlestickPatterns]{CandlestickPatterns}} -> \code{\link[tradeR:Signals]{Signals}} -> \code{\link[tradeR:StrategyBacktests]{StrategyBacktests}} -> \code{\link[tradeR:PerformanceMeasures]{PerformanceMeasures}} -> \code{AssetBasket}
}
\section{Public fields}{
  \if{html}{\out{<div class="r6-fields">}}
  \describe{
    \item{\code{KIND}}{The character kind of basket a class is, such as \code{"index"}, stored with the basket so that it is rebuilt as the same class.}

    \item{\code{name}}{The character name of the basket, such as \code{"NIFTY"} or \code{"my long-term portfolio"}.}

    \item{\code{members}}{The list of \code{BasketMember} objects the basket holds, in order.}

    \item{\code{linked_instrument}}{The \code{Instrument} the basket describes the contents of, such as the NIFTY index or an exchange traded fund, or \code{NULL} when it describes no single instrument.}

    \item{\code{unmapped_weight}}{The numeric share of the whole, between 0 and 1, held in things UBI cannot price, such as a fund's cash, which the members' weights leave out.}

    \item{\code{base_value}}{The numeric value the basket's candles start from at the first candle of a range when its members are weighted rather than counted.}
  }
  \if{html}{\out{</div>}}
}
\section{Active bindings}{
  \if{html}{\out{<div class="r6-active-bindings">}}
  \describe{
    \item{\code{instruments}}{The list of \code{Instrument} objects the basket holds, in member order.}

    \item{\code{size}}{The integer number of members in the basket.}

    \item{\code{labels}}{A character vector of member labels, such as \code{"nse:INFY"}, in member order.}

    \item{\code{weights}}{A named numeric vector of weights whose names are the member labels, normalised to sum to 1, or equal weights when no member has a weight.}

    \item{\code{last_prices}}{A \code{data.frame} with one row per member, holding \code{label}, \code{instrument_id}, \code{last_price}, \code{last_trade_time} and an \code{error} that is \code{NA} unless UBI had no price for the member, read from UBI in one request on every access.}

    \item{\code{ohlc}}{A \code{data.frame} with one row per member, holding \code{label}, \code{instrument_id}, \code{open}, \code{high}, \code{low}, \code{last_price}, \code{previous_close}, \code{change_percent} and an \code{error} that is \code{NA} unless UBI had no quote for the member, read from UBI in one request on every access.}

    \item{\code{quotes}}{A \code{data.frame} with one row per member, holding \code{label}, \code{instrument_id}, every field of UBI's unified quote such as \code{last_price}, \code{volume}, \code{oi} and \code{depth}, and an \code{error} that is \code{NA} unless UBI had no quote for the member, read from UBI in one request on every access. A field whose values are not single values, such as \code{depth}, is a list column.}

    \item{\code{day_change_percent}}{The numeric weighted move of the basket since the previous close, in percent, such as 0.8, or \code{NULL} when any member has no quote, read from UBI on every access.}

    \item{\code{advancers}}{The integer number of members trading above their previous close, read from UBI on every access.}

    \item{\code{decliners}}{The integer number of members trading below their previous close, read from UBI on every access.}

    \item{\code{breadth}}{A named list counting the members that are \code{advancers}, \code{decliners}, \code{unchanged} and \code{unavailable} since the previous close, each an integer, with the numeric \code{advance_decline_ratio} of advancers to decliners or \code{NULL} when nothing declined, read from UBI on every access.}

    \item{\code{exposure_by_segment}}{A named numeric vector of the total weight in each segment, named by segment such as \code{"nse_equities"}, largest first.}

    \item{\code{exposure_by_exchange}}{A named numeric vector of the total weight on each exchange, named by exchange such as \code{"nse"}, largest first.}

    \item{\code{concentration}}{The numeric Herfindahl index of the weights, the sum of their squares, which is 1 for a single holding and 1 divided by the size for equal weights.}

    \item{\code{effective_number_of_members}}{The numeric number of equal-weighted members that would be as concentrated as this basket, which is 1 divided by the Herfindahl index.}

    \item{\code{largest_weight}}{The numeric weight of the basket's biggest member.}
  }
  \if{html}{\out{</div>}}
}
