  transaction_type = "buy",
  product = "mis",
  order_type = "limit",
  quantity = 1,
  price = limit_price
)
order$place()
answer <- order$cancel()
print(answer$state)
for (leg in answer$cancelled_legs) {
  cat(leg$broker, leg$order_id, leg$outcome, "\n")
}

