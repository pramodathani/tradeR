\if{latex}{\out{\hypertarget{method-VolumeIndicators-on_balance_volume}{}}}
\subsection{\code{VolumeIndicators$on_balance_volume()}}{
  Adds the on balance volume, measured against one candle column.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{VolumeIndicators$on_balance_volume(
  column = "close",
  interval = "day",
  from_date = NULL,
  to_date = NULL,
  days = NULL,
  adjusted = TRUE
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{column}}{The character name of the candle column to use, such as \code{close}.}
      \item{\code{interval}}{The character candle interval, such as \code{day} or \verb{5minute}.}
      \item{\code{from_date}}{The first day of the range as a \code{Date} or a \code{YYYY-MM-DD} character, or \code{NULL} when days is given.}
      \item{\code{to_date}}{The last day of the range as a \code{Date} or a \code{YYYY-MM-DD} character, or \code{NULL} when days is given.}
      \item{\code{days}}{The integer number of days to count back from today, or \code{NULL} when from_date and to_date are given.}
      \item{\code{adjusted}}{A logical that is \code{TRUE} for prices adjusted for splits and bonuses.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Details}{
    Errors: signals \code{UnifiedBrokerInterfaceError} when UBI refused the request or could not be reached.
  }
  \subsection{Returns}{
    A \code{data.frame} of the candles with an \code{obv} column added, or \code{NULL} when UBI has no candles for the range.
  }
  \subsection{Examples}{
    \if{html}{\out{<div class="r example copy">}}
    \preformatted{infosys <- Equity$new(exchange = "nse", symbol = "INFY")
candles <- infosys$on_balance_volume(days = 90)
print(tail(candles[, c("datetime", "close", "volume", "obv")], 5))

reliance <- Equity$new(exchange = "nse", symbol = "RELIANCE")
candles <- reliance$on_balance_volume(days = 45)
closes <- candles$close
volume_line <- candles$obv
last <- nrow(candles)
price_change <- closes[[last]] - closes[[last - 20]]
volume_change <- volume_line[[last]] - volume_line[[last - 20]]
if ((price_change > 0) == (volume_change > 0)) {
  cat("Volume confirms the price move\n")
} else {
  cat("Volume diverges from the price move\n")
}

symbols <- c(
  "HDFCBANK",
  "ICICIBANK",
  "SBIN"
)
for (symbol in symbols) {
  share <- Equity$new(exchange = "nse", symbol = symbol)
  candles <- share$on_balance_volume(column = "open", days = 60)
  latest <- candles$obv[[nrow(candles)]]
  amount <- formatC(latest, format = "f", digits = 0, big.mark = ",")
  cat(sprintf("\%s: \%s\n", symbol, amount))
}
}
    \if{html}{\out{</div>}}
  }
}

