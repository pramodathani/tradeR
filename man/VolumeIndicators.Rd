\subsection{\code{VolumeIndicators$chaikin_accumulation_distribution_oscillator()}}{
  Adds the Chaikin accumulation distribution oscillator.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{VolumeIndicators$chaikin_accumulation_distribution_oscillator(
  fast_period = 3,
  slow_period = 10,
  interval = "day",
  from_date = NULL,
  to_date = NULL,
  days = NULL,
  adjusted = TRUE
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{fast_period}}{The integer number of candles in the fast exponential moving average.}
      \item{\code{slow_period}}{The integer number of candles in the slow exponential moving average.}
      \item{\code{interval}}{The character candle interval, such as \code{day} or \verb{5minute}.}
      \item{\code{from_date}}{The first day of the range as a \code{Date} or a \code{YYYY-MM-DD} character, or \code{NULL} when days is given.}
      \item{\code{to_date}}{The last day of the range as a \code{Date} or a \code{YYYY-MM-DD} character, or \code{NULL} when days is given.}
      \item{\code{days}}{The integer number of days to count back from today, or \code{NULL} when from_date and to_date are given.}
      \item{\code{adjusted}}{A logical that is \code{TRUE} for prices adjusted for splits and bonuses.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Details}{
    Errors: signals \code{UnifiedBrokerInterfaceError} when UBI refused the request or could not be reached.
  }
  \subsection{Returns}{
    A \code{data.frame} of the candles with a \verb{chaikin_adosc<fast>_<slow>} column added, or \code{NULL} when UBI has no candles for the range.
  }
  \subsection{Examples}{
    \if{html}{\out{<div class="r example copy">}}
    \preformatted{infosys <- Equity$new(exchange = "nse", symbol = "INFY")
candles <- infosys$chaikin_accumulation_distribution_oscillator(
  days = 90
)
print(tail(candles[, c("datetime", "close", "chaikin_adosc3_10")], 5))

symbols <- c(
  "INFY",
  "TCS",
  "WIPRO"
)
for (symbol in symbols) {
  share <- Equity$new(exchange = "nse", symbol = symbol)
  candles <- share$chaikin_accumulation_distribution_oscillator(
    fast_period = 5,
    slow_period = 20,
    days = 120
  )
  value <- candles$chaikin_adosc5_20[[nrow(candles)]]
  amount <- formatC(value, format = "f", digits = 0, big.mark = ",")
  if (value > 0) {
    cat(sprintf("\%s: buying pressure \%s\n", symbol, amount))
  } else {
    cat(sprintf("\%s: selling pressure \%s\n", symbol, amount))
  }
}
}
    \if{html}{\out{</div>}}
  }
}

