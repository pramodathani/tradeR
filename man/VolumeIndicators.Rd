\if{latex}{\out{\hypertarget{method-VolumeIndicators-chaikin_accumulation_distribution_line}{}}}
\subsection{\code{VolumeIndicators$chaikin_accumulation_distribution_line()}}{
  Adds the Chaikin accumulation distribution line.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{VolumeIndicators$chaikin_accumulation_distribution_line(
  interval = "day",
  from_date = NULL,
  to_date = NULL,
  days = NULL,
  adjusted = TRUE
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{interval}}{The character candle interval, such as \code{day} or \verb{5minute}.}
      \item{\code{from_date}}{The first day of the range as a \code{Date} or a \code{YYYY-MM-DD} character, or \code{NULL} when days is given.}
      \item{\code{to_date}}{The last day of the range as a \code{Date} or a \code{YYYY-MM-DD} character, or \code{NULL} when days is given.}
      \item{\code{days}}{The integer number of days to count back from today, or \code{NULL} when from_date and to_date are given.}
      \item{\code{adjusted}}{A logical that is \code{TRUE} for prices adjusted for splits and bonuses.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Details}{
    Errors: signals \code{UnifiedBrokerInterfaceError} when UBI refused the request or could not be reached.
  }
  \subsection{Returns}{
    A \code{data.frame} of the candles with a \code{chaikin_ad} column added, or \code{NULL} when UBI has no candles for the range.
  }
  \subsection{Examples}{
    \if{html}{\out{<div class="r example copy">}}
    \preformatted{infosys <- Equity$new(exchange = "nse", symbol = "INFY")
candles <- infosys$chaikin_accumulation_distribution_line(days = 90)
print(tail(candles[, c("datetime", "close", "chaikin_ad")], 5))

symbols <- c(
  "HDFCBANK",
  "ICICIBANK",
  "SBIN"
)
for (symbol in symbols) {
  share <- Equity$new(exchange = "nse", symbol = symbol)
  candles <- share$chaikin_accumulation_distribution_line(days = 45)
  line <- candles$chaikin_ad
  change <- line[[length(line)]] - line[[length(line) - 20]]
  if (change > 0) {
    amount <- formatC(change, format = "f", digits = 0, big.mark = ",")
    cat(sprintf("\%s: accumulation of \%s\n", symbol, amount))
  } else {
    amount <- formatC(-change, format = "f", digits = 0, big.mark = ",")
    cat(sprintf("\%s: distribution of \%s\n", symbol, amount))
  }
}
}
    \if{html}{\out{</div>}}
  }
}

