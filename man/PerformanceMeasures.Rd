\subsection{\code{PerformanceMeasures$sortino_ratio()}}{
  Calculates the Sortino ratio, which is the Sharpe ratio with only the falls counted as risk.

The downside deviation is the root mean square of each period's shortfall below the risk-free rate, counting a period that beat it as zero.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{PerformanceMeasures$sortino_ratio(
  risk_free_rate = 0,
  interval = "day",
  from_date = NULL,
  to_date = NULL,
  days = NULL,
  adjusted = TRUE
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{risk_free_rate}}{The numeric annual risk-free rate as a fraction, such as 0.065.}
      \item{\code{interval}}{The character candle interval, such as \code{"day"} or \code{"5minute"}.}
      \item{\code{from_date}}{The first day of the range as a \code{Date} or a \code{"YYYY-MM-DD"} character value, or \code{NULL} when \code{days} is given.}
      \item{\code{to_date}}{The last day of the range as a \code{Date} or a \code{"YYYY-MM-DD"} character value, or \code{NULL} when \code{days} is given.}
      \item{\code{days}}{The integer number of days to count back from today, or \code{NULL} when \code{from_date} and \code{to_date} are given.}
      \item{\code{adjusted}}{A logical that is \code{TRUE} for prices adjusted for splits and bonuses.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Details}{
    Errors: signals \code{ValueError} when the interval is neither \code{day} nor a minute interval such as \verb{5minute}; \code{UnifiedBrokerInterfaceError} when UBI refused the request or could not be reached.
  }
  \subsection{Returns}{
    The numeric Sortino ratio, or \code{NULL} when there are fewer than three candles or no period fell short of the risk-free rate.
  }
  \subsection{Examples}{
    \if{html}{\out{<div class="r example copy">}}
    \preformatted{nifty <- EquityIndex$new(exchange = "nse", symbol = "NIFTY")
ratio <- nifty$sortino_ratio(risk_free_rate = 0.065, days = 730)
cat(sprintf("Nifty Sortino ratio: \%.2f\n", ratio))

infosys <- Equity$new(exchange = "nse", symbol = "INFY")
sortino <- infosys$sortino_ratio(risk_free_rate = 0.065, days = 365)
sharpe <- infosys$sharpe_ratio(risk_free_rate = 0.065, days = 365)
cat(sprintf("Sortino \%.2f against Sharpe \%.2f\n", sortino, sharpe))
if (sortino > sharpe) {
  cat("The rises are larger than the falls.\n")
} else {
  cat("The falls weigh at least as much as the rises.\n")
}
}
    \if{html}{\out{</div>}}
  }
}

