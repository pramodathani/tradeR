  interval = "day",
  from_date = NULL,
  to_date = NULL,
  days = NULL,
  adjusted = TRUE
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{confidence}}{The numeric confidence level between 0 and 1, such as 0.95.}
      \item{\code{interval}}{The character candle interval, such as \code{"day"} or \code{"5minute"}.}
      \item{\code{from_date}}{The first day of the range as a \code{Date} or a \code{"YYYY-MM-DD"} character value, or \code{NULL} when \code{days} is given.}
      \item{\code{to_date}}{The last day of the range as a \code{Date} or a \code{"YYYY-MM-DD"} character value, or \code{NULL} when \code{days} is given.}
      \item{\code{days}}{The integer number of days to count back from today, or \code{NULL} when \code{from_date} and \code{to_date} are given.}
      \item{\code{adjusted}}{A logical that is \code{TRUE} for prices adjusted for splits and bonuses.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Details}{
    Errors: signals \code{ValueError} when confidence is not between 0 and 1; \code{UnifiedBrokerInterfaceError} when UBI refused the request or could not be reached.
  }
  \subsection{Returns}{
    The numeric average loss as a positive fraction, or \code{NULL} when there are fewer than three candles.
  }
  \subsection{Examples}{
    \if{html}{\out{<div class="r example copy">}}
    \preformatted{infosys <- Equity$new(exchange = "nse", symbol = "INFY")
shortfall <- infosys$expected_shortfall(confidence = 0.95, days = 365)
cat(sprintf("Expected shortfall: \%.2f\%\%\n", shortfall * 100))

nifty <- EquityIndex$new(exchange = "nse", symbol = "NIFTY")
loss <- nifty$value_at_risk(confidence = 0.95, days = 1095)
shortfall <- nifty$expected_shortfall(confidence = 0.95, days = 1095)
