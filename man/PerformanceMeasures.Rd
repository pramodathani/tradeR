\subsection{\code{PerformanceMeasures$cumulative_return()}}{
  Calculates the total growth of the close from the first candle to the last.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{PerformanceMeasures$cumulative_return(
  interval = "day",
  from_date = NULL,
  to_date = NULL,
  days = NULL,
  adjusted = TRUE
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{interval}}{The character candle interval, such as \code{"day"} or \code{"5minute"}.}
      \item{\code{from_date}}{The first day of the range as a \code{Date} or a \code{"YYYY-MM-DD"} character value, or \code{NULL} when \code{days} is given.}
      \item{\code{to_date}}{The last day of the range as a \code{Date} or a \code{"YYYY-MM-DD"} character value, or \code{NULL} when \code{days} is given.}
      \item{\code{days}}{The integer number of days to count back from today, or \code{NULL} when \code{from_date} and \code{to_date} are given.}
      \item{\code{adjusted}}{A logical that is \code{TRUE} for prices adjusted for splits and bonuses.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Details}{
    Errors: signals \code{UnifiedBrokerInterfaceError} when UBI refused the request or could not be reached.
  }
  \subsection{Returns}{
    The numeric fractional growth, such as 0.12 for 12 percent, or \code{NULL} when there are fewer than two candles.
  }
  \subsection{Examples}{
    \if{html}{\out{<div class="r example copy">}}
    \preformatted{infosys <- Equity$new(exchange = "nse", symbol = "INFY")
growth <- infosys$cumulative_return(days = 365)
cat(sprintf("Infosys over one year: \%.2f\%\%\n", growth * 100))

symbols <- c(
  "INFY",
  "TCS",
  "RELIANCE"
)
returns <- numeric(0)
for (symbol in symbols) {
  share <- Equity$new(exchange = "nse", symbol = symbol)
  returns[[symbol]] <- share$cumulative_return(
    from_date = "2025-01-01",
    to_date = "2025-12-31"
  )
}
for (symbol in names(sort(returns, decreasing = TRUE))) {
  cat(sprintf("\%s: \%.2f\%\%\n", symbol, returns[[symbol]] * 100))
}
}
    \if{html}{\out{</div>}}
  }
}

