\subsection{\code{PerformanceMeasures$sharpe_ratio()}}{
  Calculates the Sharpe ratio: the annual return above the risk-free rate for each unit of annual volatility.

A ratio above 1 is usually thought good. The annual return here is the mean return scaled to a year, which is the textbook form, rather than the compound growth rate \code{annualised_return()} gives.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{PerformanceMeasures$sharpe_ratio(
  risk_free_rate = 0,
  interval = "day",
  from_date = NULL,
  to_date = NULL,
  days = NULL,
  adjusted = TRUE
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{risk_free_rate}}{The numeric annual risk-free rate as a fraction, such as 0.065 for a 6.5 percent treasury bill.}
      \item{\code{interval}}{The character candle interval, such as \code{"day"} or \code{"5minute"}.}
      \item{\code{from_date}}{The first day of the range as a \code{Date} or a \code{"YYYY-MM-DD"} character value, or \code{NULL} when \code{days} is given.}
      \item{\code{to_date}}{The last day of the range as a \code{Date} or a \code{"YYYY-MM-DD"} character value, or \code{NULL} when \code{days} is given.}
      \item{\code{days}}{The integer number of days to count back from today, or \code{NULL} when \code{from_date} and \code{to_date} are given.}
      \item{\code{adjusted}}{A logical that is \code{TRUE} for prices adjusted for splits and bonuses.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Details}{
    Errors: signals \code{ValueError} when the interval is neither \code{day} nor a minute interval such as \verb{5minute}; \code{UnifiedBrokerInterfaceError} when UBI refused the request or could not be reached.
  }
  \subsection{Returns}{
    The numeric Sharpe ratio, or \code{NULL} when there are fewer than three candles or the price never moved.
  }
  \subsection{Examples}{
    \if{html}{\out{<div class="r example copy">}}
    \preformatted{infosys <- Equity$new(exchange = "nse", symbol = "INFY")
ratio <- infosys$sharpe_ratio(risk_free_rate = 0.065, days = 365)
cat(sprintf("Sharpe ratio: \%.2f\n", ratio))

symbols <- c(
  "INFY",
  "TCS",
  "RELIANCE"
)
best_symbol <- NULL
best_ratio <- NULL
for (symbol in symbols) {
  share <- Equity$new(exchange = "nse", symbol = symbol)
  ratio <- share$sharpe_ratio(risk_free_rate = 0.065, days = 730)
  cat(sprintf("\%s: \%.2f\n", symbol, ratio))
  if (is.null(best_ratio) || ratio > best_ratio) {
    best_symbol <- symbol
    best_ratio <- ratio
  }
}
cat(sprintf("Best Sharpe ratio: \%s\n", best_symbol))
}
    \if{html}{\out{</div>}}
  }
}

