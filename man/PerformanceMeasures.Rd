\subsection{\code{PerformanceMeasures$value_at_risk()}}{
  Estimates the loss over one candle that is not exceeded with the given confidence.

The \code{historical} method reads the loss straight from the returns in the range. The \code{parametric} method assumes returns follow a normal distribution with the range's mean and standard deviation, which understates the rare large falls real prices have.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{PerformanceMeasures$value_at_risk(
  confidence = 0.95,
  method = PERFORMANCE_MEASURES_HISTORICAL_METHOD,
  interval = "day",
  from_date = NULL,
  to_date = NULL,
  days = NULL,
  adjusted = TRUE
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{confidence}}{The numeric confidence level between 0 and 1, such as 0.95 for the loss exceeded on only one candle in twenty.}
      \item{\code{method}}{The character method, \code{"historical"} or \code{"parametric"}.}
      \item{\code{interval}}{The character candle interval, such as \code{"day"} or \code{"5minute"}.}
      \item{\code{from_date}}{The first day of the range as a \code{Date} or a \code{"YYYY-MM-DD"} character value, or \code{NULL} when \code{days} is given.}
      \item{\code{to_date}}{The last day of the range as a \code{Date} or a \code{"YYYY-MM-DD"} character value, or \code{NULL} when \code{days} is given.}
      \item{\code{days}}{The integer number of days to count back from today, or \code{NULL} when \code{from_date} and \code{to_date} are given.}
      \item{\code{adjusted}}{A logical that is \code{TRUE} for prices adjusted for splits and bonuses.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Details}{
    Errors: signals \code{ValueError} when the method is neither \code{historical} nor \code{parametric}, or confidence is not between 0 and 1; \code{UnifiedBrokerInterfaceError} when UBI refused the request or could not be reached.
  }
  \subsection{Returns}{
    The numeric loss as a positive fraction of the value, such as 0.021 for 2.1 percent, or \code{NULL} when there are fewer than three candles.
  }
  \subsection{Examples}{
    \if{html}{\out{<div class="r example copy">}}
    \preformatted{infosys <- Equity$new(exchange = "nse", symbol = "INFY")
loss <- infosys$value_at_risk(confidence = 0.95, days = 365)
cat(sprintf("One-day value at risk: \%.2f\%\%\n", loss * 100))

nifty <- EquityIndex$new(exchange = "nse", symbol = "NIFTY")
methods <- c(
  "historical",
  "parametric"
)
for (method in methods) {
  loss <- nifty$value_at_risk(
    confidence = 0.99,
    method = method,
    days = 1095
  )
  cat(sprintf("\%s: \%.2f\%\%\n", method, loss * 100))
}

infosys <- Equity$new(exchange = "nse", symbol = "INFY")
holding_value <- 500000
loss <- infosys$value_at_risk(confidence = 0.95, days = 730)
loss_in_rupees <- holding_value * loss
cat(
  sprintf(
    "Loss under Rs \%s on 19 days in 20\n",
    format(round(loss_in_rupees), big.mark = ",")
  )
)
}
    \if{html}{\out{</div>}}
  }
}

