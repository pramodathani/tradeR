  }
  \subsection{Returns}{
    The numeric Calmar ratio, or \code{NULL} when there are fewer than two candles or the close never fell.
  }
  \subsection{Examples}{
    \if{html}{\out{<div class="r example copy">}}
    \preformatted{nifty <- EquityIndex$new(exchange = "nse", symbol = "NIFTY")
