  "MovingAverageCross",
  inherit = BacktestStrategy,
  public = list(
    initialize_strategy = function() {
      self$indicator(
        "fast_average",
        talib::SMA(self$data$Close, timePeriod = 10)
      )
      self$indicator(
        "slow_average",
        talib::SMA(self$data$Close, timePeriod = 30)
