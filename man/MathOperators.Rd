\if{html}{\out{<a id="method-MathOperators-add"></a>}}
\if{latex}{\out{\hypertarget{method-MathOperators-add}{}}}
\subsection{\code{MathOperators$add()}}{
  Adds the sum of two candle columns.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{MathOperators$add(
  first_column = "high",
  second_column = "low",
  interval = "day",
  from_date = NULL,
  to_date = NULL,
  days = NULL,
  adjusted = TRUE
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{first_column}}{The character name of the first candle column.}
      \item{\code{second_column}}{The character name of the second candle column.}
      \item{\code{interval}}{The character candle interval, such as \code{day} or \verb{5minute}.}
      \item{\code{from_date}}{The first day of the range as a \code{Date} or a \code{YYYY-MM-DD} character, or \code{NULL} when days is given.}
      \item{\code{to_date}}{The last day of the range as a \code{Date} or a \code{YYYY-MM-DD} character, or \code{NULL} when days is given.}
      \item{\code{days}}{The integer number of days to count back from today, or \code{NULL} when from_date and to_date are given.}
      \item{\code{adjusted}}{A logical that is \code{TRUE} for prices adjusted for splits and bonuses.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Details}{
    Errors: signals \code{UnifiedBrokerInterfaceError} when UBI refused the request or could not be reached.
  }
  \subsection{Returns}{
    A \code{data.frame} of the candles with a \code{sum} column added, or \code{NULL} when UBI has no candles for the range.
  }
  \subsection{Examples}{
    \if{html}{\out{<div class="r example copy">}}
    \preformatted{infosys <- Equity$new(exchange = "nse", symbol = "INFY")
frame <- infosys$add(days = 30)
midpoint <- frame$sum / 2
print(tail(midpoint, 5))

nifty <- EquityIndex$new(exchange = "nse", symbol = "NIFTY")
frame <- nifty$add(
  first_column = "open",
  second_column = "close",
  days = 30
)
print(tail(frame[, c("datetime", "sum")], 5))
}
    \if{html}{\out{</div>}}
  }
}

