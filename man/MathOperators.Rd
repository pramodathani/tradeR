\subsection{\code{MathOperators$maximum_index()}}{
  Adds the row position of the highest value of one candle column over each window.

Positions are counted from 0 for the first candle, as Python's are, so the row in R is the position plus 1. The first \code{window - 1} rows, which have no full window, get 0, as Python's \code{talib} gives them.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{MathOperators$maximum_index(
  column = "close",
  window = 10,
  interval = "day",
  from_date = NULL,
  to_date = NULL,
  days = NULL,
  adjusted = TRUE
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{column}}{The character name of the candle column to use, such as \code{close}.}
