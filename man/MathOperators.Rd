  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{MathOperators$subtract(
  first_column = "high",
  second_column = "low",
  interval = "day",
  from_date = NULL,
  to_date = NULL,
  days = NULL,
  adjusted = TRUE
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{first_column}}{The character name of the first candle column.}
