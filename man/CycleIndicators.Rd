\subsection{\code{CycleIndicators$hilbert_transform_dominant_cycle_period()}}{
  Adds the Hilbert transform dominant cycle period of one candle column.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{CycleIndicators$hilbert_transform_dominant_cycle_period(
  column = "close",
  interval = "day",
  from_date = NULL,
  to_date = NULL,
  days = NULL,
  adjusted = TRUE
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{column}}{The character name of the candle column to use, such as \code{close}.}
      \item{\code{interval}}{The character candle interval, such as \code{day} or \verb{5minute}.}
      \item{\code{from_date}}{The first day of the range as a \code{Date} or a \code{YYYY-MM-DD} character, or \code{NULL} when days is given.}
      \item{\code{to_date}}{The last day of the range as a \code{Date} or a \code{YYYY-MM-DD} character, or \code{NULL} when days is given.}
      \item{\code{days}}{The integer number of days to count back from today, or \code{NULL} when from_date and to_date are given.}
      \item{\code{adjusted}}{A logical that is \code{TRUE} for prices adjusted for splits and bonuses.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Details}{
    Errors: signals \code{UnifiedBrokerInterfaceError} when UBI refused the request or could not be reached.
  }
  \subsection{Returns}{
    A \code{data.frame} of the candles with a \code{ht_dcperiod} column added, or \code{NULL} when UBI has no candles for the range.
  }
  \subsection{Examples}{
    \if{html}{\out{<div class="r example copy">}}
    \preformatted{infosys <- Equity$new(exchange = "nse", symbol = "INFY")
candles <- infosys$hilbert_transform_dominant_cycle_period(days = 365)
print(tail(candles[, c("datetime", "close", "ht_dcperiod")], 5))

instruments <- list(
  EquityIndex$new(exchange = "nse", symbol = "NIFTY"),
  Equity$new(exchange = "nse", symbol = "HDFCBANK"),
  Equity$new(exchange = "nse", symbol = "ICICIBANK"),
  Equity$new(exchange = "nse", symbol = "SBIN")
)
for (instrument in instruments) {
  candles <- instrument$hilbert_transform_dominant_cycle_period(
    days = 365
  )
  period <- candles$ht_dcperiod[[nrow(candles)]]
  cat(sprintf("\%s: \%.1f days\n", instrument$symbol, period))
}
}
    \if{html}{\out{</div>}}
  }
}

