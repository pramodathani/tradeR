\if{html}{\out{<a id="method-VolatilityIndicators-average_true_range"></a>}}
\if{latex}{\out{\hypertarget{method-VolatilityIndicators-average_true_range}{}}}
\subsection{\code{VolatilityIndicators$average_true_range()}}{
  Adds the average true range.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{VolatilityIndicators$average_true_range(
  window = 14,
  interval = "day",
  from_date = NULL,
  to_date = NULL,
  days = NULL,
  adjusted = TRUE
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{window}}{The integer number of candles in each calculation window.}
      \item{\code{interval}}{The character candle interval, such as \code{day} or \verb{5minute}.}
      \item{\code{from_date}}{The first day of the range as a \code{Date} or a \code{YYYY-MM-DD} character, or \code{NULL} when days is given.}
      \item{\code{to_date}}{The last day of the range as a \code{Date} or a \code{YYYY-MM-DD} character, or \code{NULL} when days is given.}
      \item{\code{days}}{The integer number of days to count back from today, or \code{NULL} when from_date and to_date are given.}
      \item{\code{adjusted}}{A logical that is \code{TRUE} for prices adjusted for splits and bonuses.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Details}{
    Errors: signals \code{UnifiedBrokerInterfaceError} when UBI refused the request or could not be reached.
  }
  \subsection{Returns}{
    A \code{data.frame} of the candles with a \verb{atr_<window>} column added, or \code{NULL} when UBI has no candles for the range.
  }
  \subsection{Examples}{
    \if{html}{\out{<div class="r example copy">}}
    \preformatted{infosys <- Equity$new(exchange = "nse", symbol = "INFY")
frame <- infosys$average_true_range(days = 90)
print(tail(frame[, c("datetime", "atr_14")], 5))

vodafone_idea <- Equity$new(exchange = "nse", symbol = "IDEA")
frame <- vodafone_idea$average_true_range(window = 14, days = 90)
close <- frame$close[[nrow(frame)]]
average_true_range <- frame$atr_14[[nrow(frame)]]
stop_level <- round(close - 2 * average_true_range, 2)
cat(sprintf("Close \%s, ATR \%.2f\n", close, average_true_range))
cat(sprintf("Stop level \%s\n", stop_level))
}
    \if{html}{\out{</div>}}
  }
}

