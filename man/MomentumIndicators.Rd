\if{latex}{\out{\hypertarget{method-MomentumIndicators-moving_average_convergence_divergence}{}}}
\subsection{\code{MomentumIndicators$moving_average_convergence_divergence()}}{
  Adds the moving average convergence divergence line, its signal line and their difference.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{MomentumIndicators$moving_average_convergence_divergence(
  fast_period = 12,
  slow_period = 26,
  signal_period = 9,
  column = "close",
  interval = "day",
  from_date = NULL,
  to_date = NULL,
  days = NULL,
  adjusted = TRUE
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{fast_period}}{The integer number of candles in the fast moving average.}
      \item{\code{slow_period}}{The integer number of candles in the slow moving average.}
      \item{\code{signal_period}}{The integer number of candles in the signal line's moving average.}
      \item{\code{column}}{The character name of the candle column to use, such as \code{"close"}.}
      \item{\code{interval}}{The character candle interval, such as \code{"day"} or \code{"5minute"}.}
      \item{\code{from_date}}{The first day of the range as a \code{Date} or a \code{"YYYY-MM-DD"} character value, or \code{NULL} when \code{days} is given.}
      \item{\code{to_date}}{The last day of the range as a \code{Date} or a \code{"YYYY-MM-DD"} character value, or \code{NULL} when \code{days} is given.}
      \item{\code{days}}{The integer number of days to count back from today, or \code{NULL} when \code{from_date} and \code{to_date} are given.}
      \item{\code{adjusted}}{A logical that is \code{TRUE} for prices adjusted for splits and bonuses.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Details}{
    Errors: signals \code{UnifiedBrokerInterfaceError} when UBI refused the request or could not be reached.
  }
  \subsection{Returns}{
    A \code{data.frame} of the candles with \verb{macd_<fast>_<slow>_<signal>} columns, with \verb{_signal} and \verb{_hist} variants added, or \code{NULL} when UBI has no candles for the range.
  }
  \subsection{Examples}{
    \if{html}{\out{<div class="r example copy">}}
    \preformatted{infosys <- Equity$new(exchange = "nse", symbol = "INFY")
frame <- infosys$moving_average_convergence_divergence(days = 180)
columns <- c(
  "datetime",
  "macd_12_26_9",
  "macd_12_26_9_signal",
  "macd_12_26_9_hist"
)
print(tail(frame[, columns]))

nifty <- EquityIndex$new(exchange = "nse", symbol = "NIFTY")
frame <- nifty$moving_average_convergence_divergence(
  fast_period = 8,
  slow_period = 21,
  signal_period = 5,
  days = 365
)
histogram <- frame$macd_8_21_5_hist
previous <- c(NA, histogram[-length(histogram)])
crossed_above <- which(histogram > 0 & previous <= 0)
print(as.Date(frame$datetime[crossed_above], tz = "Asia/Kolkata"))
}
    \if{html}{\out{</div>}}
  }
}

