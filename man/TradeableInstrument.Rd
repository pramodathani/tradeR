\subsection{\code{TradeableInstrument$parent()}}{
  Reads one of the order engine's parents, whether or not it has finished.

UBI finds the parent by its id alone, so this does not check that it belongs to this instrument.

The examples below, in order:
\itemize{
\item Read a held limit buy back from the order engine, then cancel it.
\item Read a parent again after cancelling it, which works because the engine keeps finished parents too.
}
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{TradeableInstrument$parent(parent_id)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{parent_id}}{The character \code{parent_id} that \code{place_order()} answered with.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Details}{
    Errors: signals \code{NotFoundError} when the order engine holds no parent with this id; \code{ServiceUnavailableError} when UBI's parents could not be read; and another \code{UnifiedBrokerInterfaceError} subclass for any other failure reported by, or on the way to, UBI.
  }
  \subsection{Returns}{
    A named list holding the parent as the engine keeps it, with \code{parent_order_id}, \code{synthetic_type}, \code{state}, \code{instrument_id}, the caller's \code{body}, the type's \code{parameters} and one entry per leg under \code{legs}.
  }
  \subsection{Examples}{
    \if{html}{\out{<div class="r example copy">}}
    \preformatted{idea <- Equity$new(exchange = "nse", symbol = "IDEA")
price <- round(idea$last_price * 0.97, 2)
answer <- idea$buy_at_limit_price(price = price, quantity = 1, product = "cnc")
parent_id <- answer[["parent_id"]]

tryCatch(
  {
    held <- idea$parent(parent_id)
    cat(held[["synthetic_type"]], held[["state"]], "\n")
    print(held[["body"]])
  },
  finally = {
    idea$cancel_parent(parent_id)
  }
)

