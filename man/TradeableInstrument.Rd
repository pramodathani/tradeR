      \item{\code{after_market}}{A logical that is \code{TRUE} to send the order as an after-market order.}
      \item{\code{tag}}{A character of up to twenty letters and digits to label the order with, or \code{NULL}.}
      \item{\code{buffer_percent}}{The numeric percentage to move the cap past the best offer, such as 0.5, or \code{NULL} for no buffer. A cap too far from the market is refused by the exchange's price protection.}
    }
    \if{html}{\out{</div>}}
  }
