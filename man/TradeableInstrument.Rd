\subsection{\code{TradeableInstrument$new()}}{
  Looks the instrument up in UBI and checks that it is not an index.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{TradeableInstrument$new(
  instrument_id = NULL,
  exchange = NULL,
  segment = NULL,
  symbol = NULL,
  underlying_symbol = NULL,
  expiry_date = NULL,
  strike_price = NULL,
  option_type = NULL,
  unified_broker_interface = NULL,
  details = NULL
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{instrument_id}}{The character UUID of the instrument, or \code{NULL} to look it up by exchange, segment and identity fields.}
      \item{\code{exchange}}{The character exchange, such as \code{"nse"}, or \code{NULL} when \code{instrument_id} is given.}
      \item{\code{segment}}{The character segment, bare such as \code{"equities"} or prefixed such as \code{"nse_equities"}, or \code{NULL} when \code{instrument_id} is given.}
      \item{\code{symbol}}{The character symbol of a security, or \code{NULL}.}
      \item{\code{underlying_symbol}}{The character symbol of a future's or option's underlying, or \code{NULL}.}
      \item{\code{expiry_date}}{The expiry of a future or option as a \code{Date} or a \code{"YYYY-MM-DD"} character value, or \code{NULL}.}
      \item{\code{strike_price}}{The numeric strike price of an option, or \code{NULL}.}
      \item{\code{option_type}}{The character option type of an option, \code{"CE"} or \code{"PE"}, or \code{NULL}.}
      \item{\code{unified_broker_interface}}{The \code{UnifiedBrokerInterface} to send requests through, or \code{NULL} to share one client among all instruments.}
      \item{\code{details}}{The named list UBI returned for this instrument from \verb{/api/instruments/details}, used instead of looking the instrument up again, or \code{NULL} to look it up from the other arguments.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Details}{
    Errors: signals \code{TradeableInstrumentError} when the instrument is an index; \code{InstrumentError} when UBI has no instrument matching the lookup; \code{BadRequestError} when the lookup is incomplete or malformed; and another \code{UnifiedBrokerInterfaceError} subclass for any other failure reported by, or on the way to, UBI.
  }
  \subsection{Returns}{
    A new \code{TradeableInstrument} object.
  }
}

