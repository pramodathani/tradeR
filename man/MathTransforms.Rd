\if{latex}{\out{\hypertarget{method-MathTransforms-hyperbolic_tangent}{}}}
\subsection{\code{MathTransforms$hyperbolic_tangent()}}{
  Adds the hyperbolic tangent of one candle column.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{MathTransforms$hyperbolic_tangent(
  column = "close",
  interval = "day",
  from_date = NULL,
  to_date = NULL,
  days = NULL,
  adjusted = TRUE
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{column}}{The character name of the candle column to use, such as \code{close}.}
      \item{\code{interval}}{The character candle interval, such as \code{day} or \verb{5minute}.}
      \item{\code{from_date}}{The first day of the range as a \code{Date} or a \code{YYYY-MM-DD} character, or \code{NULL} when days is given.}
      \item{\code{to_date}}{The last day of the range as a \code{Date} or a \code{YYYY-MM-DD} character, or \code{NULL} when days is given.}
      \item{\code{days}}{The integer number of days to count back from today, or \code{NULL} when from_date and to_date are given.}
      \item{\code{adjusted}}{A logical that is \code{TRUE} for prices adjusted for splits and bonuses.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Details}{
    Errors: signals \code{UnifiedBrokerInterfaceError} when UBI refused the request or could not be reached.
  }
  \subsection{Returns}{
    A \code{data.frame} of the candles with a \code{tanh} column added, or \code{NULL} when UBI has no candles for the range.
  }
  \subsection{Examples}{
    \if{html}{\out{<div class="r example copy">}}
    \preformatted{vodafone_idea <- Equity$new(exchange = "nse", symbol = "IDEA")
frame <- vodafone_idea$hyperbolic_tangent(days = 30)
print(tail(frame[, c("datetime", "tanh")], 5))

infosys <- Equity$new(exchange = "nse", symbol = "INFY")
frame <- infosys$hyperbolic_tangent(
  column = "price_factor",
  days = 30
)
print(tail(frame[, c("datetime", "tanh")], 5))
}
    \if{html}{\out{</div>}}
  }
}

